# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# generated brain pack zips (regenerated by prebuild)
public/brains/**/*-brain-pack.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# Brain pack assets are BUILD ARTIFACTS: scripts/sync-brain-assets.mjs (npm prebuild)
# regenerates all of public/brains/ from ../brains/*/pack on every build, locally and
# on Vercel ("Include files outside the root directory" is enabled on the project).
# The packs under brains/ are the single tracked copy.
/public/brains/
